# Default local setup (Ollama is one compatible option, not a requirement):
# HARRY_BOTTER_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
# HARRY_BOTTER_LOCAL_MODEL=qwen3:0.6b

# Default Kokoro US-English voice for browser speech output.
# Other generic presets must be auditioned and applied in the teacher preview.
HARRY_BOTTER_TTS_VOICE=af_heart

# Optional Qwen3 text-only voice design. Install the voice-design extra, prepare
# the model as described in ai-agent/voice-service/README.md, then enable it.
# Default device detection uses CUDA or Apple Silicon MPS; CPU is not recommended.
# HARRY_BOTTER_ENABLE_QWEN_VOICE_DESIGN=1
# HARRY_BOTTER_QWEN_TTS_DEVICE=cuda:0

# Optional larger model on an explicitly configured private-network host.
# Replace both values with the address and model on your trusted local server.
# HARRY_BOTTER_NETWORK_MODEL_URL=http://192.168.1.50:11434/v1
# HARRY_BOTTER_NETWORK_MODEL=qwen3:14b
